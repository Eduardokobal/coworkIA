# Segredos: nenhum arquivo .env vai para o git.
# O .env.example vai, com os nomes das variáveis e sem valores.
.env*
!.env.example

# Chaves e credenciais.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
*service-account*.json

# Configuração local do Claude Code, que é de cada máquina.
.claude/settings.local.json

# Arquivos do sistema.
.DS_Store
Thumbs.db
desktop.ini

# Editores.
.vscode/
.idea/

# Repositórios temporários dos testes das travas.
.tmp-travas/

# Node.
node_modules/
dist/
coverage/
